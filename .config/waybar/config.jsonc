// ~/.config/waybar/<filename>

// -*- mode: jsonc -*-
{
	// Waybar at top layer
  // "layer": "top", 

	// Waybar position (top|bottom|left|right)
	// "position": "bottom", i

	"height": 34, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
 
	// Gaps between modules (4px)
 	"spacing": 4, 

	// Choose the order of the modules
  "modules-left": [
		"sway/workspaces",
		"sway/window",
		"sway/mode"
  ],
  
	"modules-center": [
		"clock"
	],
  
	"modules-right": [
		"custom/battery_warning",
		"battery",
    "backlight",
		"pulseaudio",
    "cpu",
    "memory",
    "temperature",
		"network",
		"tray",
		"custom/power"
  ],
 
	// Modules configuration
	"sway/workspaces": {
		"disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}"
  },
	
//	"persistent-workspaces": {
//		"1": "[]",
//		"2": "[]",
//		"3": "[]",
//		"4": "[]",
//		"5": "[]"
//  },

	"sway/mode": {
    "format": "{}",
		"max-length": 50
  },
    
  "clock": {
    "timezone": "America/Vancouver",
		"format": "{:%a %d-%b-%y | %H:%M}",
		"format-alt": "{:%A, %B %d, %Y at %I:%M %p}",
		"tooltip": false 
  },
  
	"battery": {
    "states": {
			"good": 95,
			"warning": 20,
      "critical": 10
    },
		"interval": 10,
    "format": "\udb80\udc91\u2009{capacity}%",
    // \u2009 is a thin space
    "format-full": "\udb80\udc79{capacity}%",
    "format-charging": "\udb80\udc85 {capacity}%",
    "format-plugged": "\udb80\udc84{capacity}%",
    "format-alt": "{time}",
  //  "format-good": "" // An empty format will hide the module
		"bat": "BAT0"
  },

  "custom/battery_warning": {
    "exec": "capacity=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | sort -n | head -1); if [ -n \"$capacity\" ] && [ \"$capacity\" -lt 10 ] && [ $(cat /sys/class/power_supply/BAT*/status) = 'Discharging' ]; then echo \" LOW BATTERY \"; fi",
    "interval": 10,
    "return-type": "text",
    "format": "{}",
    "tooltip": false
  },
 
	"backlight": {
    "format": "\udb80\udf79 {percent}%",
		"tooltip": false
  },
  
	"pulseaudio": {
    "format": "\udb81\udf1f {volume}%",
    "format-muted": "\udb81\udf1f off",
		"on-click": "pauvcontrol"
	},
   
	"cpu": {
    "format": "\uf4bc {usage}%",
		"format-alt": "\uf4bc {load}"
  },
  
	"memory": {
    "format": "\uefc5 {percentage}%",
		"format-alt": "\uefc5 {used}GB",
		"tooltip-format": "{used}GB + {avail}GB = {total}GB"
  },
  
	"temperature": {
    "format": "{temperatureC}\udb81\udd04",
    "format-alt": "{temperatureF}\udb81\udd05",
		"tooltip": false
  },
  
	"network": {
    // "interface": "wlp2*", 
		// (Optional) To force the use of this interface
    "format-wifi": "\udb81\udda9 {essid}:{signalStrength}%",
    "format-ethernet": "\udb80\ude00 ethernet",
    "tooltip-format": "{ipaddr}/{cidr} via {gwaddr} (gateway)",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "Disconnected",
    "format-alt": "{ifname}"
  },
  
	"tray": {
    "icon-size": 19,
    "spacing": 10
  },
  
	"custom/power": {
    "format" : " + ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", 
		"menu-actions": {
			"exitSway": "swaymsg exit",			
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
			// Suspend (S3) saves the system state to RAM and powers down most components while keeping memory active, 
			// allowing for instant resume (1–3 seconds) but requiring continuous power to prevent data loss.  
			// Hibernate (S4) writes the entire memory contents to the swap partition or file on disk and completely powers off, 
			// ensuring zero power consumption and data safety during power loss, but requiring 15–30 seconds to resume. 
		}
  }
}
